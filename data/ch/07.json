{"n":7,"verses":[{"v":1,"sa":["राजधर्मान्प्रवक्ष्यामि यथावृत्तो भवेन्नृपः","संभवश्च यथा तस्य सिद्धिश्च परमा यथा"],"iast":["rājadharmānpravakṣyāmi yathāvṛtto bhavennṛpaḥ","sambhavaśca yathā tasya siddhiśca paramā yathā"]},{"v":2,"sa":["ब्राह्मं प्राप्तेन संस्कारं क्षत्रियेण यथाविधि","सर्वस्यास्य यथान्यायं कर्तव्यं परिरक्षणम्"],"iast":["brāhmaṃ prāptena sanskāraṃ kṣatriyeṇa yathāvidhi","sarvasyāsya yathānyāyaṃ kartavyaṃ parirakṣaṇam"]},{"v":3,"sa":["अराजके हि लोकेऽस्मिन्सर्वतो विद्रुतो भयात्","रक्षार्थं अस्य सर्वस्य राजानं असृजत्प्रभुः"],"iast":["arājake hi loke’sminsarvato vidruto bhayāt","rakṣārthaṃ asya sarvasya rājānaṃ asṛjatprabhuḥ"]},{"v":4,"sa":["इन्द्रानिलयमार्काणां अग्नेश्च वरुणस्य च","चन्द्रवित्तेशयोश्चैव मात्रा निर्हृत्य शाश्वतीः"],"iast":["indrānilayamārkāṇāṃ agneśca varuṇasya ca","candravitteśayoścaiva mātrā nirhṛtya śāśvatīḥ"]},{"v":5,"sa":["यस्मादेषां सुरेन्द्राणां मात्राभ्यो निर्मितो नृपः","तस्मादभिभवत्येष सर्वभूतानि तेजसा"],"iast":["yasmādeṣāṃ surendrāṇāṃ mātrābhyo nirmito nṛpaḥ","tasmādabhibhavatyeṣa sarvabhūtāni tejasā"]},{"v":6,"sa":["तपत्यादित्यवच्चैष चक्षूंषि च मनांसि च","न चैनं भुवि शक्नोति कश्चिदप्यभिवीक्षितुम्"],"iast":["tapatyādityavaccaiṣa cakṣūnṣi ca manānsi ca","na cainaṃ bhuvi śaknoti kaścidapyabhivīkṣitum"]},{"v":7,"sa":["सोऽग्निर्भवति वायुश्च सोऽर्कः सोमः स धर्मराट्","स कुबेरः स वरुणः स महेन्द्रः प्रभावतः"],"iast":["so’gnirbhavati vāyuśca so’rkaḥ somaḥ sa dharmarāṭ","sa kuberaḥ sa varuṇaḥ sa mahendraḥ prabhāvataḥ"]},{"v":8,"sa":["बालोऽपि नावमान्तव्यो मनुष्य इति भूमिपः","महती देवता ह्येषा नररूपेण तिष्ठति"],"iast":["bālo’pi nāvamāntavyo manuṣya iti bhūmipaḥ","mahatī devatā hyeṣā nararūpeṇa tiṣṭhati"]},{"v":9,"sa":["एकं एव दहत्यग्निर्नरं दुरुपसर्पिणम्","कुलं दहति राजाग्निः सपशुद्रव्यसंचयम्"],"iast":["ekaṃ eva dahatyagnirnaraṃ durupasarpiṇam","kulaṃ dahati rājāgniḥ sapaśudravyasan̄cayam"]},{"v":10,"sa":["कार्यं सोऽवेक्ष्य शक्तिं च देशकालौ च तत्त्वतः","कुरुते धर्मसिद्ध्यर्थं विश्वरूपं पुनः पुनः"],"iast":["kāryaṃ so’vekṣya śaktiṃ ca deśakālau ca tattvataḥ","kurute dharmasiddhyarthaṃ viśvarūpaṃ punaḥ punaḥ"]},{"v":11,"sa":["यस्य प्रसादे पद्मा श्रीर्विजयश्च पराक्रमे","मृत्युश्च वसति क्रोधे सर्वतेजोमयो हि सः"],"iast":["yasya prasāde padmā śrīrvijayaśca parākrame","mṛtyuśca vasati krodhe sarvatejomayo hi saḥ"]},{"v":12,"sa":["तं यस्तु द्वेष्टि संमोहात्स विनश्यत्यसंशयम्","तस्य ह्याशु विनाशाय राजा प्रकुरुते मनः"],"iast":["taṃ yastu dveṣṭi sammohātsa vinaśyatyasanśayam","tasya hyāśu vināśāya rājā prakurute manaḥ"]},{"v":13,"sa":["तस्माद्धर्मं यं इष्टेषु स व्यवस्येन्नराधिपः","अनिष्टं चाप्यनिष्टेषु तं धर्मं न विचालयेत्"],"iast":["tasmāddharmaṃ yaṃ iṣṭeṣu sa vyavasyennarādhipaḥ","aniṣṭaṃ cāpyaniṣṭeṣu taṃ dharmaṃ na vicālayet"]},{"v":14,"sa":["तस्यार्थे सर्वभूतानां गोप्तारं धर्मं आत्मजम्","ब्रह्मतेजोमयं दण्डं असृजत्पूर्वं ईश्वरः"],"iast":["tasyārthe sarvabhūtānāṃ goptāraṃ dharmaṃ ātmajam","brahmatejomayaṃ daṇḍaṃ asṛjatpūrvaṃ īśvaraḥ"]},{"v":15,"sa":["तस्य सर्वाणि भूतानि स्थावराणि चराणि च","भयाद्भोगाय कल्पन्ते स्वधर्मान्न चलन्ति च"],"iast":["tasya sarvāṇi bhūtāni sthāvarāṇi carāṇi ca","bhayādbhogāya kalpante svadharmānna calanti ca"]},{"v":16,"sa":["तं देशकालौ शक्तिं च विद्यां चावेक्ष्य तत्त्वतः","यथार्हतः संप्रणयेन्नरेष्वन्यायवर्तिषु"],"iast":["taṃ deśakālau śaktiṃ ca vidyāṃ cāvekṣya tattvataḥ","yathārhataḥ sampraṇayennareṣvanyāyavartiṣu"]},{"v":17,"sa":["स राजा पुरुषो दण्डः स नेता शासिता च सः","चतुर्णां आश्रमाणां च धर्मस्य प्रतिभूः स्मृतः"],"iast":["sa rājā puruṣo daṇḍaḥ sa netā śāsitā ca saḥ","caturṇāṃ āśramāṇāṃ ca dharmasya pratibhūḥ smṛtaḥ"]},{"v":18,"sa":["दण्डः शास्ति प्रजाः सर्वा दण्ड एवाभिरक्षति","दण्डः सुप्तेषु जागर्ति दण्डं धर्मं विदुर्बुधाः"],"iast":["daṇḍaḥ śāsti prajāḥ sarvā daṇḍa evābhirakṣati","daṇḍaḥ supteṣu jāgarti daṇḍaṃ dharmaṃ vidurbudhāḥ"]},{"v":19,"sa":["समीक्ष्य स धृतः सम्यक्सर्वा रञ्जयति प्रजाः","असमीक्ष्य प्रणीतस्तु विनाशयति सर्वतः"],"iast":["samīkṣya sa dhṛtaḥ samyaksarvā rañjayati prajāḥ","asamīkṣya praṇītastu vināśayati sarvataḥ"]},{"v":20,"sa":["यदि न प्रणयेद्राजा दण्डं दण्ड्येष्वतन्द्रितः","शूले मत्स्यानिवापक्ष्यन्दुर्बलान्बलवत्तराः"],"iast":["yadi na praṇayedrājā daṇḍaṃ daṇḍyeṣvatandritaḥ","śūle matsyānivāpakṣyandurbalānbalavattarāḥ"]},{"v":21,"sa":["अद्यात्काकः पुरोडाशं श्वा च लिह्याद्धविस्तथा","स्वाम्यं च न स्यात्कस्मिंश्चित्प्रवर्तेताधरोत्तरम्"],"iast":["adyātkākaḥ puroḍāśaṃ śvā ca lihyāddhavistathā","svāmyaṃ ca na syātkasminścitpravartetādharottaram"]},{"v":22,"sa":["सर्वो दण्डजितो लोको दुर्लभो हि शुचिर्नरः","दण्डस्य हि भयात्सर्वं जगद्भोगाय कल्पते"],"iast":["sarvo daṇḍajito loko durlabho hi śucirnaraḥ","daṇḍasya hi bhayātsarvaṃ jagadbhogāya kalpate"]},{"v":23,"sa":["देवदानवगन्धर्वा रक्षांसि पतगोरगाः","तेऽपि भोगाय कल्पन्ते दण्डेनैव निपीडिताः"],"iast":["devadānavagandharvā rakṣānsi patagoragāḥ","te’pi bhogāya kalpante daṇḍenaiva nipīḍitāḥ"]},{"v":24,"sa":["दुष्येयुः सर्ववर्णाश्च भिद्येरन्सर्वसेतवः","सर्वलोकप्रकोपश्च भवेद्दण्डस्य विभ्रमात्"],"iast":["duṣyeyuḥ sarvavarṇāśca bhidyeransarvasetavaḥ","sarvalokaprakopaśca bhaveddaṇḍasya vibhramāt"]},{"v":25,"sa":["यत्र श्यामो लोहिताक्षो दण्डश्चरति पापहा","प्रजास्तत्र न मुह्यन्ति नेता चेत्साधु पश्यति"],"iast":["yatra śyāmo lohitākṣo daṇḍaścarati pāpahā","prajāstatra na muhyanti netā cetsādhu paśyati"]},{"v":26,"sa":["तस्याहुः संप्रणेतारं राजानं सत्यवादिनम्","समीक्ष्यकारिणं प्राज्ञं धर्मकामार्थकोविदम्"],"iast":["tasyāhuḥ sampraṇetāraṃ rājānaṃ satyavādinam","samīkṣyakāriṇaṃ prājñaṃ dharmakāmārthakovidam"]},{"v":27,"sa":["तं राजा प्रणयन्सम्यक्त्रिवर्गेणाभिवर्धते","कामात्मा विषमः क्षुद्रो दण्डेनैव निहन्यते"],"iast":["taṃ rājā praṇayansamyaktrivargeṇābhivardhate","kāmātmā viṣamaḥ kṣudro daṇḍenaiva nihanyate"]},{"v":28,"sa":["दण्डो हि सुमहत्तेजो दुर्धरश्चाकृतात्मभिः","धर्माद्विचलितं हन्ति नृपं एव सबान्धवम्"],"iast":["daṇḍo hi sumahattejo durdharaścākṛtātmabhiḥ","dharmādvicalitaṃ hanti nṛpaṃ eva sabāndhavam"]},{"v":29,"sa":["ततो दुर्गं च राष्ट्रं च लोकं च सचराचरम्","अन्तरिक्षगतांश्चैव मुनीन्देवांश्च पीडयेत्"],"iast":["tato durgaṃ ca rāṣṭraṃ ca lokaṃ ca sacarācaram","antarikṣagatānścaiva munīndevānśca pīḍayet"]},{"v":30,"sa":["सोऽसहायेन मूढेन लुब्धेनाकृतबुद्धिना","न शक्यो न्यायतो नेतुं सक्तेन विषयेषु च"],"iast":["so’sahāyena mūḍhena lubdhenākṛtabuddhinā","na śakyo nyāyato netuṃ saktena viṣayeṣu ca"]},{"v":31,"sa":["शुचिना सत्यसंधेन यथाशास्त्रानुसारिणा","प्रणेतुं शक्यते दण्डः सुसहायेन धीमता"],"iast":["śucinā satyasandhena yathāśāstrānusāriṇā","praṇetuṃ śakyate daṇḍaḥ susahāyena dhīmatā"]},{"v":32,"sa":["स्वराष्ट्रे न्यायवृत्तः स्याद्भृशदण्डश्च शत्रुषु","सुहृत्स्वजिह्मः स्निग्धेषु ब्राह्मणेषु क्षमान्वितः"],"iast":["svarāṣṭre nyāyavṛttaḥ syādbhṛśadaṇḍaśca śatruṣu","suhṛtsvajihmaḥ snigdheṣu brāhmaṇeṣu kṣamānvitaḥ"]},{"v":33,"sa":["एवंवृत्तस्य नृपतेः शिलोञ्छेनापि जीवतः","विस्तीर्यते यशो लोके तैलबिन्दुरिवाम्भसि"],"iast":["evanvṛttasya nṛpateḥ śiloñchenāpi jīvataḥ","vistīryate yaśo loke tailabindurivāmbhasi"]},{"v":34,"sa":["अतस्तु विपरीतस्य नृपतेरजितात्मनः","संक्षिप्यते यशो लोके घृतबिन्दुरिवाम्भसि"],"iast":["atastu viparītasya nṛpaterajitātmanaḥ","saṅkṣipyate yaśo loke ghṛtabindurivāmbhasi"]},{"v":35,"sa":["स्वे स्वे धर्मे निविष्टानां सर्वेषां अनुपूर्वशः","वर्णानां आश्रमाणां च राजा सृष्टोऽभिरक्षिता"],"iast":["sve sve dharme niviṣṭānāṃ sarveṣāṃ anupūrvaśaḥ","varṇānāṃ āśramāṇāṃ ca rājā sṛṣṭo’bhirakṣitā"]},{"v":36,"sa":["तेन यद्यत्सभृत्येन कर्तव्यं रक्षता प्रजाः","तत्तद्वोऽहं प्रवक्ष्यामि यथावदनुपूर्वशः"],"iast":["tena yadyatsabhṛtyena kartavyaṃ rakṣatā prajāḥ","tattadvo’haṃ pravakṣyāmi yathāvadanupūrvaśaḥ"]},{"v":37,"sa":["ब्राह्मणान्पर्युपासीत प्रातरुत्थाय पार्थिवः","त्रैविद्यवृद्धान्विदुषस्तिष्ठेत्तेषां च शासने"],"iast":["brāhmaṇānparyupāsīta prātarutthāya pārthivaḥ","traividyavṛddhānviduṣastiṣṭhetteṣāṃ ca śāsane"]},{"v":38,"sa":["वृद्धांश्च नित्यं सेवेत विप्रान्वेदविदः शुचीन्","वृद्धसेवी हि सततं रक्षोभिरपि पूज्यते"],"iast":["vṛddhānśca nityaṃ seveta viprānvedavidaḥ śucīn","vṛddhasevī hi satataṃ rakṣobhirapi pūjyate"]},{"v":39,"sa":["तेभ्योऽधिगच्छेद्विनयं विनीतात्मापि नित्यशः","विनीतात्मा हि नृपतिर्न विनश्यति कर्हि चित्"],"iast":["tebhyo’dhigacchedvinayaṃ vinītātmāpi nityaśaḥ","vinītātmā hi nṛpatirna vinaśyati karhi cit"]},{"v":40,"sa":["बहवोऽविनयान्नष्टा राजानः सपरिच्छदाः","वनस्था अपि राज्यानि विनयात्प्रतिपेदिरे"],"iast":["bahavo’vinayānnaṣṭā rājānaḥ saparicchadāḥ","vanasthā api rājyāni vinayātpratipedire"]},{"v":41,"sa":["वेनो विनष्टोऽविनयान्नहुषश्चैव पार्थिवः","सुदाः पैजवनश्चैव सुमुखो निमिरेव च"],"iast":["veno vinaṣṭo’vinayānnahuṣaścaiva pārthivaḥ","sudāḥ paijavanaścaiva sumukho nimireva ca"]},{"v":42,"sa":["पृथुस्तु विनयाद्राज्यं प्राप्तवान्मनुरेव च","कुबेरश्च धनैश्वर्यं ब्राह्मण्यं चैव गाधिजः"],"iast":["pṛthustu vinayādrājyaṃ prāptavānmanureva ca","kuberaśca dhanaiśvaryaṃ brāhmaṇyaṃ caiva gādhijaḥ"]},{"v":43,"sa":["त्रैविद्येभ्यस्त्रयीं विद्यां दण्डनीतिं च शाश्वतीम्","आन्वीक्षिकीं चात्मविद्यां वार्तारम्भांश्च लोकतः"],"iast":["traividyebhyastrayīṃ vidyāṃ daṇḍanītiṃ ca śāśvatīm","ānvīkṣikīṃ cātmavidyāṃ vārtārambhānśca lokataḥ"]},{"v":44,"sa":["इन्द्रियाणां जये योगं समातिष्ठेद्दिवानिशम्","जितेन्द्रियो हि शक्नोति वशे स्थापयितुं प्रजाः"],"iast":["indriyāṇāṃ jaye yogaṃ samātiṣṭheddivāniśam","jitendriyo hi śaknoti vaśe sthāpayituṃ prajāḥ"]},{"v":45,"sa":["दश कामसमुत्थानि तथाष्टौ क्रोधजानि च","व्यसनानि दुरन्तानि प्रयत्नेन विवर्जयेत्"],"iast":["daśa kāmasamutthāni tathāṣṭau krodhajāni ca","vyasanāni durantāni prayatnena vivarjayet"]},{"v":46,"sa":["कामजेषु प्रसक्तो हि व्यसनेषु महीपतिः","वियुज्यतेऽर्थधर्माभ्यां क्रोधजेष्वात्मनैव तु"],"iast":["kāmajeṣu prasakto hi vyasaneṣu mahīpatiḥ","viyujyate’rthadharmābhyāṃ krodhajeṣvātmanaiva tu"]},{"v":47,"sa":["मृगयाक्षो दिवास्वप्नः परिवादः स्त्रियो मदः","तौर्यत्रिकं वृथाट्या च कामजो दशको गणः"],"iast":["mṛgayākṣo divāsvapnaḥ parivādaḥ striyo madaḥ","tauryatrikaṃ vṛthāṭyā ca kāmajo daśako gaṇaḥ"]},{"v":48,"sa":["पैशुन्यं साहसं द्रोह ईर्ष्यासूयार्थदूषणम्","वाग्दण्डजं च पारुष्यं क्रोधजोऽपि गणोऽष्टकः"],"iast":["paiśunyaṃ sāhasaṃ droha īrṣyāsūyārthadūṣaṇam","vāgdaṇḍajaṃ ca pāruṣyaṃ krodhajo’pi gaṇo’ṣṭakaḥ"]},{"v":49,"sa":["द्वयोरप्येतयोर्मूलं यं सर्वे कवयो विदुः","तं यत्नेन जयेल्लोभं तज्जावेतावुभौ गणौ"],"i
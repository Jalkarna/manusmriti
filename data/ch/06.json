{"n":6,"verses":[{"v":1,"sa":["एवं गृहाश्रमे स्थित्वा विधिवत्स्नातको द्विजः","वने वसेत्तु नियतो यथावद्विजितेन्द्रियः"],"iast":["evaṃ gṛhāśrame sthitvā vidhivatsnātako dvijaḥ","vane vasettu niyato yathāvadvijitendriyaḥ"]},{"v":2,"sa":["गृहस्थस्तु यथा पश्येद्वलीपलितं आत्मनः","अपत्यस्यैव चापत्यं तदारण्यं समाश्रयेत्"],"iast":["gṛhasthastu yathā paśyedvalīpalitaṃ ātmanaḥ","apatyasyaiva cāpatyaṃ tadāraṇyaṃ samāśrayet"]},{"v":3,"sa":["संत्यज्य ग्राम्यं आहारं सर्वं चैव परिच्छदम्","पुत्रेषु भार्यां निक्षिप्य वनं गच्छेत्सहैव वा"],"iast":["santyajya grāmyaṃ āhāraṃ sarvaṃ caiva paricchadam","putreṣu bhāryāṃ nikṣipya vanaṃ gacchetsahaiva vā"]},{"v":4,"sa":["अग्निहोत्रं समादाय गृह्यं चाग्निपरिच्छदम्","ग्रामादरण्यं निःसृत्य निवसेन्नियतेन्द्रियः"],"iast":["agnihotraṃ samādāya gṛhyaṃ cāgniparicchadam","grāmādaraṇyaṃ niḥsṛtya nivasenniyatendriyaḥ"]},{"v":5,"sa":["मुन्यन्नैर्विविधैर्मेध्यैः शाकमूलफलेन वा","एतानेव महायज्ञान्निर्वपेद्विधिपूर्वकम्"],"iast":["munyannairvividhairmedhyaiḥ śākamūlaphalena vā","etāneva mahāyajñānnirvapedvidhipūrvakam"]},{"v":6,"sa":["वसीत चर्म चीरं वा सायं स्नायात्प्रगे तथा","जटाश्च बिभृयान्नित्यं श्मश्रुलोमनखानि च"],"iast":["vasīta carma cīraṃ vā sāyaṃ snāyātprage tathā","jaṭāśca bibhṛyānnityaṃ śmaśrulomanakhāni ca"]},{"v":7,"sa":["यद्भक्ष्यं स्याद्ततो दद्याद्बलिं भिक्षां च शक्तितः","अम्मूलफलभिक्षाभिरर्चयेदाश्रमागतान्"],"iast":["yadbhakṣyaṃ syādtato dadyādbaliṃ bhikṣāṃ ca śaktitaḥ","ammūlaphalabhikṣābhirarcayedāśramāgatān"]},{"v":8,"sa":["स्वाध्याये नित्ययुक्तः स्याद्दान्तो मैत्रः समाहितः","दाता नित्यं अनादाता सर्वभूतानुकम्पकः"],"iast":["svādhyāye nityayuktaḥ syāddānto maitraḥ samāhitaḥ","dātā nityaṃ anādātā sarvabhūtānukampakaḥ"]},{"v":9,"sa":["वैतानिकं च जुहुयादग्निहोत्रं यथाविधि","दर्शं अस्कन्दयन्पर्व पौर्णमासं च योगतः"],"iast":["vaitānikaṃ ca juhuyādagnihotraṃ yathāvidhi","darśaṃ askandayanparva paurṇamāsaṃ ca yogataḥ"]},{"v":10,"sa":["ऋक्षेष्ट्याग्रयणं चैव चातुर्मास्यानि चाहरेत्","तुरायणं च क्रमशो दक्षस्यायनं एव च"],"iast":["ṛkṣeṣṭyāgrayaṇaṃ caiva cāturmāsyāni cāharet","turāyaṇaṃ ca kramaśo dakṣasyāyanaṃ eva ca"]},{"v":11,"sa":["वासन्तशारदैर्मेध्यैर्मुन्यन्नैः स्वयं आहृतैः","पुरोडाशांश्चरूंश्चैव विधिवन्निर्वपेत्पृथक्"],"iast":["vāsantaśāradairmedhyairmunyannaiḥ svayaṃ āhṛtaiḥ","puroḍāśānścarūnścaiva vidhivannirvapetpṛthak"]},{"v":12,"sa":["देवताभ्यस्तु तद्धुत्वा वन्यं मेध्यतरं हविः","शेषं आत्मनि युञ्जीत लवणं च स्वयं कृतम्"],"iast":["devatābhyastu taddhutvā vanyaṃ medhyataraṃ haviḥ","śeṣaṃ ātmani yuñjīta lavaṇaṃ ca svayaṃ kṛtam"]},{"v":13,"sa":["स्थलजाउदकशाकानि पुष्पमूलफलानि च","मेध्यवृक्षोद्भवान्यद्यात्स्नेहांश्च फलसंभवान्"],"iast":["sthalajāudakaśākāni puṣpamūlaphalāni ca","medhyavṛkṣodbhavānyadyātsnehānśca phalasambhavān"]},{"v":14,"sa":["वर्जयेन्मधु मांसं च भौमानि कवकानि च","भूस्तृणं शिग्रुकं चैव श्लेश्मातकफलानि च"],"iast":["varjayenmadhu mānsaṃ ca bhaumāni kavakāni ca","bhūstṛṇaṃ śigrukaṃ caiva śleśmātakaphalāni ca"]},{"v":15,"sa":["त्यजेदाश्वयुजे मासि मुन्यन्नं पूर्वसंचितम्","जीर्णानि चैव वासांसि शाकमूलफलानि च"],"iast":["tyajedāśvayuje māsi munyannaṃ pūrvasan̄citam","jīrṇāni caiva vāsānsi śākamūlaphalāni ca"]},{"v":16,"sa":["न फालकृष्टं अश्नीयादुत्सृष्टं अपि केन चित्","न ग्रामजातान्यार्तोऽपि मूलाणि च फलानि च"],"iast":["na phālakṛṣṭaṃ aśnīyādutsṛṣṭaṃ api kena cit","na grāmajātānyārto’pi mūlāṇi ca phalāni ca"]},{"v":17,"sa":["अग्निपक्वाशनो वा स्यात्कालपक्वभुगेव वा","अश्मकुट्टो भवेद्वापि दन्तोलूखलिकोऽपि वा"],"iast":["agnipakvāśano vā syātkālapakvabhugeva vā","aśmakuṭṭo bhavedvāpi dantolūkhaliko’pi vā"]},{"v":18,"sa":["सद्यः प्रक्षालको वा स्यान्माससंचयिकोऽपि वा","षण्मासनिचयो वा स्यात्समानिचय एव वा"],"iast":["sadyaḥ prakṣālako vā syānmāsasan̄cayiko’pi vā","ṣaṇmāsanicayo vā syātsamānicaya eva vā"]},{"v":19,"sa":["नक्तं चान्नं समश्नीयाद्दिवा वाहृत्य शक्तितः","चतुर्थकालिको वा स्यात्स्याद्वाप्यष्टमकालिकः"],"iast":["naktaṃ cānnaṃ samaśnīyāddivā vāhṛtya śaktitaḥ","caturthakāliko vā syātsyādvāpyaṣṭamakālikaḥ"]},{"v":20,"sa":["चान्द्रायणविधानैर्वा शुक्लकृष्णे च वर्तयेत्","पक्षान्तयोर्वाप्यश्नीयाद्यवागूं क्वथितां सकृत्"],"iast":["cāndrāyaṇavidhānairvā śuklakṛṣṇe ca vartayet","pakṣāntayorvāpyaśnīyādyavāgūṃ kvathitāṃ sakṛt"]},{"v":21,"sa":["पुष्पमूलफलैर्वापि केवलैर्वर्तयेत्सदा","कालपक्वैः स्वयं शीर्णैर्वैखानसमते स्थितः"],"iast":["puṣpamūlaphalairvāpi kevalairvartayetsadā","kālapakvaiḥ svayaṃ śīrṇairvaikhānasamate sthitaḥ"]},{"v":22,"sa":["भूमौ विपरिवर्तेत तिष्ठेद्वा प्रपदैर्दिनम्","स्थानासनाभ्यां विहरेत्सवनेषूपयन्नपः"],"iast":["bhūmau viparivarteta tiṣṭhedvā prapadairdinam","sthānāsanābhyāṃ viharetsavaneṣūpayannapaḥ"]},{"v":23,"sa":["ग्रीष्मे पञ्चतपास्तु स्याद्वर्षास्वभ्रावकाशिकः","आर्द्रवासास्तु हेमन्ते क्रमशो वर्धयंस्तपः"],"iast":["grīṣme pañcatapāstu syādvarṣāsvabhrāvakāśikaḥ","ārdravāsāstu hemante kramaśo vardhayanstapaḥ"]},{"v":24,"sa":["उपस्पृशंस्त्रिषवणं पितॄन्देवांश्च तर्पयेत्","तपश्चरंश्चोग्रतरं शोषयेद्देहं आत्मनः"],"iast":["upaspṛśanstriṣavaṇaṃ pitṝndevānśca tarpayet","tapaścaranścogrataraṃ śoṣayeddehaṃ ātmanaḥ"]},{"v":25,"sa":["अग्नीनात्मनि वैतानान्समारोप्य यथाविधि","अनग्निरनिकेतः स्यान्मुनिर्मूलफलाशनः"],"iast":["agnīnātmani vaitānānsamāropya yathāvidhi","anagniraniketaḥ syānmunirmūlaphalāśanaḥ"]},{"v":26,"sa":["अप्रयत्नः सुखार्थेषु ब्रह्मचारी धराशयः","शरणेष्वममश्चैव वृक्षमूलनिकेतनः"],"iast":["aprayatnaḥ sukhārtheṣu brahmacārī dharāśayaḥ","śaraṇeṣvamamaścaiva vṛkṣamūlaniketanaḥ"]},{"v":27,"sa":["तापसेष्वेव विप्रेषु यात्रिकं भैक्षं आहरेत्","गृहमेधिषु चान्येषु द्विजेषु वनवासिषु"],"iast":["tāpaseṣveva vipreṣu yātrikaṃ bhaikṣaṃ āharet","gṛhamedhiṣu cānyeṣu dvijeṣu vanavāsiṣu"]},{"v":28,"sa":["ग्रामादाहृत्य वाश्नीयादष्टौ ग्रासान्वने वसन्","प्रतिगृह्य पुटेनैव पाणिना शकलेन वा"],"iast":["grāmādāhṛtya vāśnīyādaṣṭau grāsānvane vasan","pratigṛhya puṭenaiva pāṇinā śakalena vā"]},{"v":29,"sa":["एताश्चान्याश्च सेवेत दीक्षा विप्रो वने वसन्","विविधाश्चाउपनिषदीरात्मसंसिद्धये श्रुतीः"],"iast":["etāścānyāśca seveta dīkṣā vipro vane vasan","vividhāścāupaniṣadīrātmasansiddhaye śrutīḥ"]},{"v":30,"sa":["ऋषिभिर्ब्राह्मणैश्चैव गृहस्थैरेव सेविताः","विद्यातपोविवृद्ध्यर्थं शरीरस्य च शुद्धये"],"iast":["ṛṣibhirbrāhmaṇaiścaiva gṛhasthaireva sevitāḥ","vidyātapovivṛddhyarthaṃ śarīrasya ca śuddhaye"]},{"v":31,"sa":["अपराजितां वास्थाय व्रजेद्दिशं अजिह्मगः","आ निपाताच्छरीरस्य युक्तो वार्यनिलाशनः"],"iast":["aparājitāṃ vāsthāya vrajeddiśaṃ ajihmagaḥ","ā nipātāccharīrasya yukto vāryanilāśanaḥ"]},{"v":32,"sa":["आसां महर्षिचर्याणां त्यक्त्वान्यतमया तनुम्","वीतशोकभयो विप्रो ब्रह्मलोके महीयते"],"iast":["āsāṃ maharṣicaryāṇāṃ tyaktvānyatamayā tanum","vītaśokabhayo vipro brahmaloke mahīyate"]},{"v":33,"sa":["वनेषु च विहृत्यैवं तृतीयं भागं आयुषः","चतुर्थं आयुषो भागं त्यक्वा सङ्गान्परिव्रजेत्"],"iast":["vaneṣu ca vihṛtyaivaṃ tṛtīyaṃ bhāgaṃ āyuṣaḥ","caturthaṃ āyuṣo bhāgaṃ tyakvā saṅgānparivrajet"]},{"v":34,"sa":["आश्रमादाश्रमं गत्वा हुतहोमो जितेन्द्रियः","भिक्षाबलिपरिश्रान्तः प्रव्रजन्प्रेत्य वर्धते"],"iast":["āśramādāśramaṃ gatvā hutahomo jitendriyaḥ","bhikṣābalipariśrāntaḥ pravrajanpretya vardhate"]},{"v":35,"sa":["ऋणानि त्रीण्यपाकृत्य मनो मोक्षे निवेशयेत्","अनपाकृत्य मोक्षं तु सेवमानो व्रजत्यधः"],"iast":["ṛṇāni trīṇyapākṛtya mano mokṣe niveśayet","anapākṛtya mokṣaṃ tu sevamāno vrajatyadhaḥ"]},{"v":36,"sa":["अधीत्य विधिवद्वेदान्पुत्रांश्चोत्पाद्य धर्मतः","इष्ट्वा च शक्तितो यज्ञैर्मनो मोक्षे निवेशयेत्"],"iast":["adhītya vidhivadvedānputrānścotpādya dharmataḥ","iṣṭvā ca śaktito yajñairmano mokṣe niveśayet"]},{"v":37,"sa":["अनधीत्य द्विजो वेदाननुत्पाद्य तथा सुतान्","अनिष्ट्वा चैव यज्ञैश्च मोक्षं इच्छन्व्रजत्यधः"],"iast":["anadhītya dvijo vedānanutpādya tathā sutān","aniṣṭvā caiva yajñaiśca mokṣaṃ icchanvrajatyadhaḥ"]},{"v":38,"sa":["प्राजापत्यं निरुप्येष्टिं सर्ववेदसदक्षिणाम्","आत्मन्यग्नीन्समारोप्य ब्राह्मणः प्रव्रजेद्गृहात्"],"iast":["prājāpatyaṃ nirupyeṣṭiṃ sarvavedasadakṣiṇām","ātmanyagnīnsamāropya brāhmaṇaḥ pravrajedgṛhāt"]},{"v":39,"sa":["यो दत्त्वा सर्वभूतेभ्यः प्रव्रजत्यभयं गृहात्","तस्य तेजोमया लोका भवन्ति ब्रह्मवादिनः"],"iast":["yo dattvā sarvabhūtebhyaḥ pravrajatyabhayaṃ gṛhāt","tasya tejomayā lokā bhavanti brahmavādinaḥ"]},{"v":40,"sa":["यस्मादण्वपि भूतानां द्विजान्नोत्पद्यते भयम्","तस्य देहाद्विमुक्तस्य भयं नास्ति कुतश्चन"],"iast":["yasmādaṇvapi bhūtānāṃ dvijānnotpadyate bhayam","tasya dehādvimuktasya bhayaṃ nāsti kutaścana"]},{"v":41,"sa":["अगारादभिनिष्क्रान्तः पवित्रोपचितो मुनिः","समुपोढेषु कामेषु निरपेक्षः परिव्रजेत्"],"iast":["agārādabhiniṣkrāntaḥ pavitropacito muniḥ","samupoḍheṣu kāmeṣu nirapekṣaḥ parivrajet"]},{"v":42,"sa":["एक एव चरेन्नित्यं सिद्ध्यर्थं असहायवान्","सिद्धिं एकस्य संपश्यन्न जहाति न हीयते"],"iast":["eka eva carennityaṃ siddhyarthaṃ asahāyavān","siddhiṃ ekasya sampaśyanna jahāti na hīyate"]},{"v":43,"sa":["अनग्निरनिकेतः स्याद्ग्रामं अन्नार्थं आश्रयेत्","उपेक्षकोऽसंकुसुको मुनिर्भावसमाहितः"],"iast":["anagniraniketaḥ syādgrāmaṃ annārthaṃ āśrayet","upekṣako’saṅkusuko munirbhāvasamāhitaḥ"]},{"v":44,"sa":["कपालं वृक्षमूलानि कुचेलं असहायता","समता चैव सर्वस्मिन्नेतन्मुक्तस्य लक्षणम्"],"iast":["kapālaṃ vṛkṣamūlāni kucelaṃ asahāyatā","samatā caiva sarvasminnetanmuktasya lakṣaṇam"]},{"v":45,"sa":["नाभिनन्देत मरणं नाभिनन्देत जीवितम्","कालं एव प्रतीक्षेत निर्वेशं भृतको यथा"],"iast":["nābhinandeta maraṇaṃ nābhinandeta jīvitam","kālaṃ eva pratīkṣeta nirveśaṃ bhṛtako yathā"]},{"v":46,"sa":["दृष्टिपूतं न्यसेत्पादं वस्त्रपूतं जलं पिबेत्","सत्यपूतां वदेद्वाचं मनःपूतं समाचरेत्"],"iast":["dṛṣṭipūtaṃ nyasetpādaṃ vastrapūtaṃ jalaṃ pibet","satyapūtāṃ vadedvācaṃ manaḥpūtaṃ samācaret"]},{"v":47,"sa":["अतिवादांस्तितिक्षेत नावमन्येत कं चन","न चेमं देहं आश्रित्य वैरं कुर्वीत केन चित्"],"iast":["ativādānstitikṣeta nāvamanyeta kaṃ cana","na cemaṃ dehaṃ āśritya vairaṃ kurvīta kena cit"]},{"v":48,"sa":["क्रुद्ध्यन्तं न प्रतिक्रुध्येदाक्रुष्टः कुशलं वदेत्","सप्तद्वारावकीर्णां च न वाचं अनृतां वदेत्"],"iast":["kruddhyantaṃ na pratikrudhyedākruṣṭaḥ kuśalaṃ vadet","saptadvārāvakīrṇāṃ ca na vācaṃ anṛtāṃ vadet"]},{"v":49,"sa":["अध्यात्मरतिरासीनो निरपेक्षो निरामिषः","आत्मनैव सहायेन सुखार्थी विचरेदिह"],"iast":["adhyātmaratirāsīno nirapekṣo nirāmiṣaḥ","ātmanaiva sahāyena sukhārthī vicarediha"]},{"v":50,"sa":["न चोत्पातनिमित्ताभ्यां न नक्षत्राङ्गविद्यया","
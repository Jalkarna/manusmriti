{"n":1,"verses":[{"v":1,"sa":["मनुं एकाग्रं आसीनं अभिगम्य महर्षयः","प्रतिपूज्य यथान्यायं इदं वचनं अब्रुवन्"],"iast":["manuṃ ekāgraṃ āsīnaṃ abhigamya maharṣayaḥ","pratipūjya yathānyāyaṃ idaṃ vacanaṃ abruvan"]},{"v":2,"sa":["भगवन्सर्ववर्णानां यथावदनुपूर्वशः","अन्तरप्रभवानां च धर्मान्नो वक्तुं अर्हसि"],"iast":["bhagavansarvavarṇānāṃ yathāvadanupūrvaśaḥ","antaraprabhavānāṃ ca dharmānno vaktuṃ arhasi"]},{"v":3,"sa":["त्वं एको ह्यस्य सर्वस्य विधानस्य स्वयंभुवः","अचिन्त्यस्याप्रमेयस्य कार्यतत्त्वार्थवित्प्रभो"],"iast":["tvaṃ eko hyasya sarvasya vidhānasya svayambhuvaḥ","acintyasyāprameyasya kāryatattvārthavitprabho"]},{"v":4,"sa":["स तैः पृष्टस्तथा सम्यगमितौजा महात्मभिः","प्रत्युवाचार्च्य तान्सर्वान्महर्षीञ् श्रूयतां इति"],"iast":["sa taiḥ pṛṣṭastathā samyagamitaujā mahātmabhiḥ","pratyuvācārcya tānsarvānmaharṣīñ śrūyatāṃ iti"]},{"v":5,"sa":["आसीदिदं तमोभूतं अप्रज्ञातं अलक्षणम्","अप्रतर्क्यं अविज्ञेयं प्रसुप्तं इव सर्वतः"],"iast":["āsīdidaṃ tamobhūtaṃ aprajñātaṃ alakṣaṇam","apratarkyaṃ avijñeyaṃ prasuptaṃ iva sarvataḥ"]},{"v":6,"sa":["ततः स्वयंभूर्भगवानव्यक्तो व्यञ्जयन्निदम्","महाभूतादि वृत्तौजाः प्रादुरासीत्तमोनुदः"],"iast":["tataḥ svayambhūrbhagavānavyakto vyañjayannidam","mahābhūtādi vṛttaujāḥ prādurāsīttamonudaḥ"]},{"v":7,"sa":["योऽसावतीन्द्रियग्राह्यः सूक्ष्मोऽव्यक्तः सनातनः","सर्वभूतमयोऽचिन्त्यः स एव स्वयं उद्बभौ"],"iast":["yo’sāvatīndriyagrāhyaḥ sūkṣmo’vyaktaḥ sanātanaḥ","sarvabhūtamayo’cintyaḥ sa eva svayaṃ udbabhau"]},{"v":8,"sa":["सोऽभिध्याय शरीरात्स्वात्सिसृक्षुर्विविधाः प्रजाः","अप एव ससर्जादौ तासु वीर्यं अवासृजत्"],"iast":["so’bhidhyāya śarīrātsvātsisṛkṣurvividhāḥ prajāḥ","apa eva sasarjādau tāsu vīryaṃ avāsṛjat"]},{"v":9,"sa":["तदण्डं अभवद्धैमं सहस्रांशुसमप्रभम्","तस्मिञ् जज्ञे स्वयं ब्रह्मा सर्वलोकपितामहः"],"iast":["tadaṇḍaṃ abhavaddhaimaṃ sahasrānśusamaprabham","tasmiñ jajñe svayaṃ brahmā sarvalokapitāmahaḥ"]},{"v":10,"sa":["आपो नारा इति प्रोक्ता आपो वै नरसूनवः","ता यदस्यायनं पूर्वं तेन नारायणः स्मृतः"],"iast":["āpo nārā iti proktā āpo vai narasūnavaḥ","tā yadasyāyanaṃ pūrvaṃ tena nārāyaṇaḥ smṛtaḥ"]},{"v":11,"sa":["यत्तत्कारणं अव्यक्तं नित्यं सदसदात्मकम्","तद्विसृष्टः स पुरुषो लोके ब्रह्मेति कीर्त्यते"],"iast":["yattatkāraṇaṃ avyaktaṃ nityaṃ sadasadātmakam","tadvisṛṣṭaḥ sa puruṣo loke brahmeti kīrtyate"]},{"v":12,"sa":["तस्मिन्नण्डे स भगवानुषित्वा परिवत्सरम्","स्वयं एवात्मनो ध्यानात्तदण्डं अकरोद्द्विधा"],"iast":["tasminnaṇḍe sa bhagavānuṣitvā parivatsaram","svayaṃ evātmano dhyānāttadaṇḍaṃ akaroddvidhā"]},{"v":13,"sa":["ताभ्यां स शकलाभ्यां च दिवं भूमिं च निर्ममे","मध्ये व्योम दिशश्चाष्टावपां स्थानं च शाश्वतम्"],"iast":["tābhyāṃ sa śakalābhyāṃ ca divaṃ bhūmiṃ ca nirmame","madhye vyoma diśaścāṣṭāvapāṃ sthānaṃ ca śāśvatam"]},{"v":14,"sa":["उद्बबर्हात्मनश्चैव मनः सदसदात्मकम्","मनसश्चाप्यहंकारं अभिमन्तारं ईश्वरम्"],"iast":["udbabarhātmanaścaiva manaḥ sadasadātmakam","manasaścāpyahaṅkāraṃ abhimantāraṃ īśvaram"]},{"v":15,"sa":["महान्तं एव चात्मानं सर्वाणि त्रिगुणानि च","विषयाणां ग्रहीतॄणि शनैः पञ्चेन्द्रियाणि च"],"iast":["mahāntaṃ eva cātmānaṃ sarvāṇi triguṇāni ca","viṣayāṇāṃ grahītṝṇi śanaiḥ pañcendriyāṇi ca"]},{"v":16,"sa":["तेषां त्ववयवान्सूक्ष्मान्षण्णां अप्यमितौजसाम्","संनिवेश्यात्ममात्रासु सर्वभूतानि निर्ममे"],"iast":["teṣāṃ tvavayavānsūkṣmānṣaṇṇāṃ apyamitaujasām","sanniveśyātmamātrāsu sarvabhūtāni nirmame"]},{"v":17,"sa":["यन्मूर्त्यवयवाः सूक्ष्मास्तानीमान्याश्रयन्ति षट्","तस्माच्छरीरं इत्याहुस्तस्य मूर्तिं मनीषिणः"],"iast":["yanmūrtyavayavāḥ sūkṣmāstānīmānyāśrayanti ṣaṭ","tasmāccharīraṃ ityāhustasya mūrtiṃ manīṣiṇaḥ"]},{"v":18,"sa":["तदाविशन्ति भूतानि महान्ति सह कर्मभिः","मनश्चावयवैः सूक्ष्मैः सर्वभूतकृदव्ययम्"],"iast":["tadāviśanti bhūtāni mahānti saha karmabhiḥ","manaścāvayavaiḥ sūkṣmaiḥ sarvabhūtakṛdavyayam"]},{"v":19,"sa":["तेषां इदं तु सप्तानां पुरुषाणां महौजसाम्","सूक्ष्माभ्यो मूर्तिमात्राभ्यः संभवत्यव्ययाद्व्ययम्"],"iast":["teṣāṃ idaṃ tu saptānāṃ puruṣāṇāṃ mahaujasām","sūkṣmābhyo mūrtimātrābhyaḥ sambhavatyavyayādvyayam"]},{"v":20,"sa":["आद्याद्यस्य गुणं त्वेषां अवाप्नोति परः परः","यो यो यावतिथश्चैषां स स तावद्गुणः स्मृतः"],"iast":["ādyādyasya guṇaṃ tveṣāṃ avāpnoti paraḥ paraḥ","yo yo yāvatithaścaiṣāṃ sa sa tāvadguṇaḥ smṛtaḥ"]},{"v":21,"sa":["सर्वेषां तु स नामानि कर्माणि च पृथक्पृथक्","वेदशब्देभ्य एवादौ पृथक्संस्थाश्च निर्ममे"],"iast":["sarveṣāṃ tu sa nāmāni karmāṇi ca pṛthakpṛthak","vedaśabdebhya evādau pṛthaksansthāśca nirmame"]},{"v":22,"sa":["कर्मात्मनां च देवानां सोऽसृजत्प्राणिनां प्रभुः","साध्यानां च गणं सूक्ष्मं यज्ञं चैव सनातनम्"],"iast":["karmātmanāṃ ca devānāṃ so’sṛjatprāṇināṃ prabhuḥ","sādhyānāṃ ca gaṇaṃ sūkṣmaṃ yajñaṃ caiva sanātanam"]},{"v":23,"sa":["अग्निवायुरविभ्यस्तु त्रयं ब्रह्म सनातनम्","दुदोह यज्ञसिद्ध्यर्थं ऋग्यजुःसामलक्षणम्"],"iast":["agnivāyuravibhyastu trayaṃ brahma sanātanam","dudoha yajñasiddhyarthaṃ ṛgyajuḥsāmalakṣaṇam"]},{"v":24,"sa":["कालं कालविभक्तीश्च नक्षत्राणि ग्रहांस्तथा","सरितः सागराञ् शैलान्समानि विषमानि च"],"iast":["kālaṃ kālavibhaktīśca nakṣatrāṇi grahānstathā","saritaḥ sāgarāñ śailānsamāni viṣamāni ca"]},{"v":25,"sa":["तपो वाचं रतिं चैव कामं च क्रोधं एव च","सृष्टिं ससर्ज चैवेमां स्रष्टुं इच्छन्निमाः प्रजाः"],"iast":["tapo vācaṃ ratiṃ caiva kāmaṃ ca krodhaṃ eva ca","sṛṣṭiṃ sasarja caivemāṃ sraṣṭuṃ icchannimāḥ prajāḥ"]},{"v":26,"sa":["कर्मणां च विवेकार्थं धर्माधर्मौ व्यवेचयत्","द्वन्द्वैरयोजयच्चेमाः सुखदुःखादिभिः प्रजाः"],"iast":["karmaṇāṃ ca vivekārthaṃ dharmādharmau vyavecayat","dvandvairayojayaccemāḥ sukhaduḥkhādibhiḥ prajāḥ"]},{"v":27,"sa":["अण्व्यो मात्रा विनाशिन्यो दशार्धानां तु याः स्मृताः","ताभिः सार्धं इदं सर्वं संभवत्यनुपूर्वशः"],"iast":["aṇvyo mātrā vināśinyo daśārdhānāṃ tu yāḥ smṛtāḥ","tābhiḥ sārdhaṃ idaṃ sarvaṃ sambhavatyanupūrvaśaḥ"]},{"v":28,"sa":["यं तु कर्मणि यस्मिन्स न्ययुङ्क्त प्रथमं प्रभुः","स तदेव स्वयं भेजे सृज्यमानः पुनः पुनः"],"iast":["yaṃ tu karmaṇi yasminsa nyayuṅkta prathamaṃ prabhuḥ","sa tadeva svayaṃ bheje sṛjyamānaḥ punaḥ punaḥ"]},{"v":29,"sa":["हिंस्राहिंस्रे मृदुक्रूरे धर्माधर्मावृतानृते","यद्यस्य सोऽदधात्सर्गे तत्तस्य स्वयं आविशत्"],"iast":["hinsrāhinsre mṛdukrūre dharmādharmāvṛtānṛte","yadyasya so’dadhātsarge tattasya svayaṃ āviśat"]},{"v":30,"sa":["यथा र्तुलिङ्गान्यृतवः स्वयं एव र्तुपर्यये","स्वानि स्वान्यभिपद्यन्ते तथा कर्माणि देहिनः"],"iast":["yathā rtuliṅgānyṛtavaḥ svayaṃ eva rtuparyaye","svāni svānyabhipadyante tathā karmāṇi dehinaḥ"]},{"v":31,"sa":["लोकानां तु विवृद्ध्यर्थं मुखबाहूरुपादतः","ब्राह्मणं क्षत्रियं वैश्यं शूद्रं च निरवर्तयत्"],"iast":["lokānāṃ tu vivṛddhyarthaṃ mukhabāhūrupādataḥ","brāhmaṇaṃ kṣatriyaṃ vaiśyaṃ śūdraṃ ca niravartayat"]},{"v":32,"sa":["द्विधा कृत्वात्मनो देहं अर्धेन पुरुषोऽभवत्","अर्धेन नारी तस्यां स विराजं असृजत्प्रभुः"],"iast":["dvidhā kṛtvātmano dehaṃ ardhena puruṣo’bhavat","ardhena nārī tasyāṃ sa virājaṃ asṛjatprabhuḥ"]},{"v":33,"sa":["तपस्तप्त्वासृजद्यं तु स स्वयं पुरुषो विराट्","तं मां वित्तास्य सर्वस्य स्रष्टारं द्विजसत्तमाः"],"iast":["tapastaptvāsṛjadyaṃ tu sa svayaṃ puruṣo virāṭ","taṃ māṃ vittāsya sarvasya sraṣṭāraṃ dvijasattamāḥ"]},{"v":34,"sa":["अहं प्रजाः सिसृक्षुस्तु तपस्तप्त्वा सुदुश्चरम्","पतीन्प्रजानां असृजं महर्षीनादितो दश"],"iast":["ahaṃ prajāḥ sisṛkṣustu tapastaptvā suduścaram","patīnprajānāṃ asṛjaṃ maharṣīnādito daśa"]},{"v":35,"sa":["मरीचिं अत्र्यङ्गिरसौ पुलस्त्यं पुलहं क्रतुम्","प्रचेतसं वसिष्ठं च भृगुं नारदं एव च"],"iast":["marīciṃ atryaṅgirasau pulastyaṃ pulahaṃ kratum","pracetasaṃ vasiṣṭhaṃ ca bhṛguṃ nāradaṃ eva ca"]},{"v":36,"sa":["एते मनूंस्तु सप्तान्यानसृजन्भूरितेजसः","देवान्देवनिकायांश्च महर्षींश्चामितौजसः"],"iast":["ete manūnstu saptānyānasṛjanbhūritejasaḥ","devāndevanikāyānśca maharṣīnścāmitaujasaḥ"]},{"v":37,"sa":["यक्षरक्षःपिशाचांश्च गन्धर्वाप्सरसोऽसुरान्","नागान्सर्पान्सुपर्णांश्च पितॄणांश्च पृथग्गणम्"],"iast":["yakṣarakṣaḥpiśācānśca gandharvāpsaraso’surān","nāgānsarpānsuparṇānśca pitṝṇānśca pṛthaggaṇam"]},{"v":38,"sa":["विद्युतोऽशनिमेघांश्च रोहितेन्द्रधनूंषि च","उल्कानिर्घातकेतूंश्च ज्योतींष्युच्चावचानि च"],"iast":["vidyuto’śanimeghānśca rohitendradhanūnṣi ca","ulkānirghātaketūnśca jyotīnṣyuccāvacāni ca"]},{"v":39,"sa":["किन्नरान्वानरान्मत्स्यान्विविधांश्च विहङ्गमान्","पशून्मृगान्मनुष्यांश्च व्यालांश्चोभयतोदतः"],"iast":["kinnarānvānarānmatsyānvividhānśca vihaṅgamān","paśūnmṛgānmanuṣyānśca vyālānścobhayatodataḥ"]},{"v":40,"sa":["कृमिकीटपतङ्गांश्च यूकामक्षिकमत्कुणम्","सर्वं च दंशमशकं स्थावरं च पृथग्विधम्"],"iast":["kṛmikīṭapataṅgānśca yūkāmakṣikamatkuṇam","sarvaṃ ca danśamaśakaṃ sthāvaraṃ ca pṛthagvidham"]},{"v":41,"sa":["एवं एतैरिदं सर्वं मन्नियोगान्महात्मभिः","यथाकर्म तपोयोगात्सृष्टं स्थावरजङ्गमम्"],"iast":["evaṃ etairidaṃ sarvaṃ manniyogānmahātmabhiḥ","yathākarma tapoyogātsṛṣṭaṃ sthāvarajaṅgamam"]},{"v":42,"sa":["येषां तु यादृषं कर्म भूतानां इह कीर्तितम्","तत्तथा वोऽभिधास्यामि क्रमयोगं च जन्मनि"],"iast":["yeṣāṃ tu yādṛṣaṃ karma bhūtānāṃ iha kīrtitam","tattathā vo’bhidhāsyāmi kramayogaṃ ca janmani"]},{"v":43,"sa":["पशवश्च मृगाश्चैव व्यालाश्चोभयतोदतः","रक्षांसि च पिशाचाश्च मनुष्याश्च जरायुजाः"],"iast":["paśavaśca mṛgāścaiva vyālāścobhayatodataḥ","rakṣānsi ca piśācāśca manuṣyāśca jarāyujāḥ"]},{"v":44,"sa":["अण्डाजाः पक्षिणः सर्पा नक्रा मत्स्याश्च कच्छपाः","यानि चैवंः प्रकाराणि स्थलजान्यौदकानि च"],"iast":["aṇḍājāḥ pakṣiṇaḥ sarpā nakrā matsyāśca kacchapāḥ","yāni caivaṃḥ prakārāṇi sthalajānyaudakāni ca"]},{"v":45,"sa":["स्वेदजं दंशमशकं यूकामक्षिकमत्कुणम्","ऊष्मणश्चोपजायन्ते यच्चान्यत्किं चिदीदृषम्"],"iast":["svedajaṃ danśamaśakaṃ yūkāmakṣikamatkuṇam","ūṣmaṇaścopajāyante yaccānyatkiṃ cidīdṛṣam"]},{"v":46,"sa":["उद्भिज्जाः स्थावराः सर्वे बीजकाण्डप्ररोहिणः","ओषध्यः फलपाकान्ता बहुपुष्पफलोपगाः"],"iast":["udbhijjāḥ sthāvarāḥ sarve bījakāṇḍaprarohiṇaḥ","oṣadhyaḥ phalapākāntā bahupuṣpaphalopagāḥ"]},{"v":47,"sa":["अपुष्पाः फलवन्तो ये ते वनस्पतयः स्मृताः","पुष्पिणः फलिनश्चैव वृक्षास्तूभयतः स्मृताः"],"iast":["apuṣpāḥ phalavanto ye te vanaspatayaḥ smṛtāḥ","puṣpiṇaḥ phalinaścaiva vṛkṣāstūbhayataḥ smṛtāḥ"]},{"v":48,"sa":["गुच्छगुल्मं तु विविधं तथैव तृणजातयः","बीजकाण्डरुहाण्येव प्रताना वल्ल्य एव च"],"iast":["gucchagulmaṃ tu vividhaṃ tathaiva tṛṇajātayaḥ","bījakāṇḍaruhāṇyeva pratānā vallya eva ca"]},{"v":49,"sa":["तमसा बहुरूपेण वेष्टिताः कर्महेतुना","अन्तःसंज्ञा भवन्त्येते सुखदुःखस
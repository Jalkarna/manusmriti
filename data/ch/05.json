{"n":5,"verses":[{"v":1,"sa":["श्रुत्वैतानृषयो धर्मान्स्नातकस्य यथोदितान्","इदं ऊचुर्महात्मानं अनलप्रभवं भृगुम्"],"iast":["śrutvaitānṛṣayo dharmānsnātakasya yathoditān","idaṃ ūcurmahātmānaṃ analaprabhavaṃ bhṛgum"]},{"v":2,"sa":["एवं यथोक्तं विप्राणां स्वधर्मं अनुतिष्ठताम्","कथं मृत्युः प्रभवति वेदशास्त्रविदां प्रभो"],"iast":["evaṃ yathoktaṃ viprāṇāṃ svadharmaṃ anutiṣṭhatām","kathaṃ mṛtyuḥ prabhavati vedaśāstravidāṃ prabho"]},{"v":3,"sa":["स तानुवाच धर्मात्मा महर्षीन्मानवो भृगुः","श्रूयतां येन दोषेण मृत्युर्विप्रान्जिघांसति"],"iast":["sa tānuvāca dharmātmā maharṣīnmānavo bhṛguḥ","śrūyatāṃ yena doṣeṇa mṛtyurviprānjighānsati"]},{"v":4,"sa":["अनभ्यासेन वेदानां आचारस्य च वर्जनात्","आलस्यादन्नदोषाच्च मृत्युर्विप्राञ् जिघांसति"],"iast":["anabhyāsena vedānāṃ ācārasya ca varjanāt","ālasyādannadoṣācca mṛtyurviprāñ jighānsati"]},{"v":5,"sa":["लशुनं गृञ्जनं चैव पलाण्डुं कवकानि च","अभक्ष्याणि द्विजातीनां अमेध्यप्रभवानि च"],"iast":["laśunaṃ gṛñjanaṃ caiva palāṇḍuṃ kavakāni ca","abhakṣyāṇi dvijātīnāṃ amedhyaprabhavāni ca"]},{"v":6,"sa":["लोहितान्वृक्षनिर्यासान्वृश्चनप्रभवांस्तथा","शेलुं गव्यं च पेयूषं प्रयत्नेन विवर्जयेत्"],"iast":["lohitānvṛkṣaniryāsānvṛścanaprabhavānstathā","śeluṃ gavyaṃ ca peyūṣaṃ prayatnena vivarjayet"]},{"v":7,"sa":["वृथा कृसरसंयावं पायसापूपं एव च","अनुपाकृतमांसानि देवान्नानि हवींषि च"],"iast":["vṛthā kṛsarasanyāvaṃ pāyasāpūpaṃ eva ca","anupākṛtamānsāni devānnāni havīnṣi ca"]},{"v":8,"sa":["अनिर्दशाया गोः क्षीरं औष्ट्रं ऐकशफं तथा","आविकं संधिनीक्षीरं विवत्सायाश्च गोः पयः"],"iast":["anirdaśāyā goḥ kṣīraṃ auṣṭraṃ aikaśaphaṃ tathā","āvikaṃ sandhinīkṣīraṃ vivatsāyāśca goḥ payaḥ"]},{"v":9,"sa":["आरण्यानां च सर्वेषां मृगाणां माहिषं विना","स्त्रीक्षीरं चैव वर्ज्यानि सर्वशुक्तानि चैव हि"],"iast":["āraṇyānāṃ ca sarveṣāṃ mṛgāṇāṃ māhiṣaṃ vinā","strīkṣīraṃ caiva varjyāni sarvaśuktāni caiva hi"]},{"v":10,"sa":["दधि भक्ष्यं च शुक्तेषु सर्वं च दधिसंभवम्","यानि चैवाभिषूयन्ते पुष्पमूलफलैः शुभैः"],"iast":["dadhi bhakṣyaṃ ca śukteṣu sarvaṃ ca dadhisambhavam","yāni caivābhiṣūyante puṣpamūlaphalaiḥ śubhaiḥ"]},{"v":11,"sa":["क्रव्यादाञ् शकुनान्सर्वांस्तथा ग्रामनिवासिनः","अनिर्दिष्टांश्चैकशफांष्टिट्टिभं च विवर्जयेत्"],"iast":["kravyādāñ śakunānsarvānstathā grāmanivāsinaḥ","anirdiṣṭānścaikaśaphānṣṭiṭṭibhaṃ ca vivarjayet"]},{"v":12,"sa":["कलविङ्कं प्लवं हंसं चक्राह्वं ग्रामकुक्कुटम्","सारसं रज्जुवालं च दात्यूहं शुकसारिके"],"iast":["kalaviṅkaṃ plavaṃ hansaṃ cakrāhvaṃ grāmakukkuṭam","sārasaṃ rajjuvālaṃ ca dātyūhaṃ śukasārike"]},{"v":13,"sa":["प्रतुदाञ् जालपादांश्च कोयष्टिनखविष्किरान्","निमज्जतश्च मत्स्यादान्सौनं वल्लूरं एव च"],"iast":["pratudāñ jālapādānśca koyaṣṭinakhaviṣkirān","nimajjataśca matsyādānsaunaṃ vallūraṃ eva ca"]},{"v":14,"sa":["बकं चैव बलाकां च काकोलं खञ्जरीटकम्","मत्स्यादान्विड्वराहांश्च मत्स्यानेव च सर्वशः"],"iast":["bakaṃ caiva balākāṃ ca kākolaṃ khañjarīṭakam","matsyādānviḍvarāhānśca matsyāneva ca sarvaśaḥ"]},{"v":15,"sa":["यो यस्य मांसं अश्नाति स तन्मांसाद उच्यते","मत्स्यादः सर्वमांसादस्तस्मान्मत्स्यान्विवर्जयेत्"],"iast":["yo yasya mānsaṃ aśnāti sa tanmānsāda ucyate","matsyādaḥ sarvamānsādastasmānmatsyānvivarjayet"]},{"v":16,"sa":["पाठीनरोहितावाद्यौ नियुक्तौ हव्यकव्ययोः","राजीवान्सिंहतुण्डाश्च सशल्काश्चैव सर्वशः"],"iast":["pāṭhīnarohitāvādyau niyuktau havyakavyayoḥ","rājīvānsinhatuṇḍāśca saśalkāścaiva sarvaśaḥ"]},{"v":17,"sa":["न भक्षयेदेकचरानज्ञातांश्च मृगद्विजान्","भक्ष्येष्वपि समुद्दिष्टान्सर्वान्पञ्चनखांस्तथा"],"iast":["na bhakṣayedekacarānajñātānśca mṛgadvijān","bhakṣyeṣvapi samuddiṣṭānsarvānpañcanakhānstathā"]},{"v":18,"sa":["श्वाविधं शल्यकं गोधां खड्गकूर्मशशांस्तथा","भक्ष्यान्पञ्चनखेष्वाहुरनुष्ट्रांश्चैकतोदतह्"],"iast":["śvāvidhaṃ śalyakaṃ godhāṃ khaḍgakūrmaśaśānstathā","bhakṣyānpañcanakheṣvāhuranuṣṭrānścaikatodatah"]},{"v":19,"sa":["छत्राकं विड्वराहं च लशुनं ग्रामकुक्कुटम्","पलाण्डुं गृञ्जनं चैव मत्या जग्ध्वा पतेद्द्विजः"],"iast":["chatrākaṃ viḍvarāhaṃ ca laśunaṃ grāmakukkuṭam","palāṇḍuṃ gṛñjanaṃ caiva matyā jagdhvā pateddvijaḥ"]},{"v":20,"sa":["अमत्यैतानि षड्जग्ध्वा कृच्छ्रं सान्तपनं चरेत्","यतिचान्द्रायाणं वापि शेषेषूपवसेदहः"],"iast":["amatyaitāni ṣaḍjagdhvā kṛcchraṃ sāntapanaṃ caret","yaticāndrāyāṇaṃ vāpi śeṣeṣūpavasedahaḥ"]},{"v":21,"sa":["संवत्सरस्यैकं अपि चरेत्कृच्छ्रं द्विजोत्तमः","अज्ञातभुक्तशुद्ध्यर्थं ज्ञातस्य तु विषेशतः"],"iast":["sanvatsarasyaikaṃ api caretkṛcchraṃ dvijottamaḥ","ajñātabhuktaśuddhyarthaṃ jñātasya tu viṣeśataḥ"]},{"v":22,"sa":["यज्ञार्थं ब्राह्मणैर्वध्याः प्रशस्ता मृगपक्षिणः","भृत्यानां चैव वृत्त्यर्थं अगस्त्यो ह्याचरत्पुरा"],"iast":["yajñārthaṃ brāhmaṇairvadhyāḥ praśastā mṛgapakṣiṇaḥ","bhṛtyānāṃ caiva vṛttyarthaṃ agastyo hyācaratpurā"]},{"v":23,"sa":["बभूवुर्हि पुरोडाशा भक्ष्याणां मृगपक्षिणाम्","पुराणेष्वपि यज्ञेषु ब्रह्मक्षत्रसवेषु च"],"iast":["babhūvurhi puroḍāśā bhakṣyāṇāṃ mṛgapakṣiṇām","purāṇeṣvapi yajñeṣu brahmakṣatrasaveṣu ca"]},{"v":24,"sa":["यत्किं चित्स्नेहसंयुक्तं भक्ष्यं भोज्यं अगर्हितम्","तत्पर्युषितं अप्याद्यं हविःशेषं च यद्भवेत्"],"iast":["yatkiṃ citsnehasanyuktaṃ bhakṣyaṃ bhojyaṃ agarhitam","tatparyuṣitaṃ apyādyaṃ haviḥśeṣaṃ ca yadbhavet"]},{"v":25,"sa":["चिरस्थितं अपि त्वाद्यं अस्नेहाक्तं द्विजातिभिः","यवगोधूमजं सर्वं पयसश्चैव विक्रिया"],"iast":["cirasthitaṃ api tvādyaṃ asnehāktaṃ dvijātibhiḥ","yavagodhūmajaṃ sarvaṃ payasaścaiva vikriyā"]},{"v":26,"sa":["एतदुक्तं द्विजातीनां भक्ष्याभक्ष्यं अशेषतः","मांसस्यातः प्रवक्ष्यामि विधिं भक्षणवर्जने"],"iast":["etaduktaṃ dvijātīnāṃ bhakṣyābhakṣyaṃ aśeṣataḥ","mānsasyātaḥ pravakṣyāmi vidhiṃ bhakṣaṇavarjane"]},{"v":27,"sa":["प्रोक्षितं भक्षयेन्मांसं ब्राह्मणानां च काम्यया","यथाविधि नियुक्तस्तु प्राणानां एव चात्यये"],"iast":["prokṣitaṃ bhakṣayenmānsaṃ brāhmaṇānāṃ ca kāmyayā","yathāvidhi niyuktastu prāṇānāṃ eva cātyaye"]},{"v":28,"sa":["प्राणस्यान्नं इदं सर्वं प्रजापतिरकल्पयत्","स्थावरं जङ्गमं चैव सर्वं प्राणस्य भोजनम्"],"iast":["prāṇasyānnaṃ idaṃ sarvaṃ prajāpatirakalpayat","sthāvaraṃ jaṅgamaṃ caiva sarvaṃ prāṇasya bhojanam"]},{"v":29,"sa":["चराणां अन्नं अचरा दंष्ट्रिणां अप्यदंष्ट्रिणः","अहस्ताश्च सहस्तानां शूराणां चैव भीरवः"],"iast":["carāṇāṃ annaṃ acarā danṣṭriṇāṃ apyadanṣṭriṇaḥ","ahastāśca sahastānāṃ śūrāṇāṃ caiva bhīravaḥ"]},{"v":30,"sa":["नात्ता दुष्यत्यदन्नाद्यान्प्राणिनोऽहन्यहन्यपि","धात्रैव सृष्टा ह्याद्याश्च प्राणिनोऽत्तार एव च"],"iast":["nāttā duṣyatyadannādyānprāṇino’hanyahanyapi","dhātraiva sṛṣṭā hyādyāśca prāṇino’ttāra eva ca"]},{"v":31,"sa":["यज्ञाय जग्धिर्मांसस्येत्येष दैवो विधिः स्मृतः","अतोऽन्यथा प्रवृत्तिस्तु राक्षसो विधिरुच्यते"],"iast":["yajñāya jagdhirmānsasyetyeṣa daivo vidhiḥ smṛtaḥ","ato’nyathā pravṛttistu rākṣaso vidhirucyate"]},{"v":32,"sa":["क्रीत्वा स्वयं वाप्युत्पाद्य परोपकृतं एव वा","देवान्पितॄंश्चार्चयित्वा खादन्मांसं न दुष्यति"],"iast":["krītvā svayaṃ vāpyutpādya paropakṛtaṃ eva vā","devānpitṝnścārcayitvā khādanmānsaṃ na duṣyati"]},{"v":33,"sa":["नाद्यादविधिना मांसं विधिज्ञोऽनापदि द्विजः","जग्ध्वा ह्यविधिना मांसं प्रेतस्तैरद्यतेऽवशः"],"iast":["nādyādavidhinā mānsaṃ vidhijño’nāpadi dvijaḥ","jagdhvā hyavidhinā mānsaṃ pretastairadyate’vaśaḥ"]},{"v":34,"sa":["न तादृशं भवत्येनो मृगहन्तुर्धनार्थिनः","यादृशं भवति प्रेत्य वृथामांसानि खादतः"],"iast":["na tādṛśaṃ bhavatyeno mṛgahanturdhanārthinaḥ","yādṛśaṃ bhavati pretya vṛthāmānsāni khādataḥ"]},{"v":35,"sa":["नियुक्तस्तु यथान्यायं यो मांसं नात्ति मानवः","स प्रेत्य पशुतां याति संभवानेकविंशतिम्"],"iast":["niyuktastu yathānyāyaṃ yo mānsaṃ nātti mānavaḥ","sa pretya paśutāṃ yāti sambhavānekavinśatim"]},{"v":36,"sa":["असंस्कृतान्पशून्मन्त्रैर्नाद्याद्विप्रः कदा चन","मन्त्रैस्तु संस्कृतानद्याच्छाश्वतं विधिं आस्थितः"],"iast":["asanskṛtānpaśūnmantrairnādyādvipraḥ kadā cana","mantraistu sanskṛtānadyācchāśvataṃ vidhiṃ āsthitaḥ"]},{"v":37,"sa":["कुर्याद्घृतपशुं सङ्गे कुर्यात्पिष्टपशुं तथा","न त्वेव तु वृथा हन्तुं पशुं इच्छेत्कदा चन"],"iast":["kuryādghṛtapaśuṃ saṅge kuryātpiṣṭapaśuṃ tathā","na tveva tu vṛthā hantuṃ paśuṃ icchetkadā cana"]},{"v":38,"sa":["यावन्ति पशुरोमाणि तावत्कृत्वो ह मारणम्","वृथापशुघ्नः प्राप्नोति प्रेत्य जन्मनि जन्मनि"],"iast":["yāvanti paśuromāṇi tāvatkṛtvo ha māraṇam","vṛthāpaśughnaḥ prāpnoti pretya janmani janmani"]},{"v":39,"sa":["यज्ञार्थं पशवः सृष्टाः स्वयं एव स्वयंभुवा","यज्ञोऽस्य भूत्यै सर्वस्य तस्माद्यज्ञे वधोऽवधः"],"iast":["yajñārthaṃ paśavaḥ sṛṣṭāḥ svayaṃ eva svayambhuvā","yajño’sya bhūtyai sarvasya tasmādyajñe vadho’vadhaḥ"]},{"v":40,"sa":["ओषध्यः पशवो वृक्षास्तिर्यञ्चः पक्षिणस्तथा","यज्ञार्थं निधनं प्राप्ताः प्राप्नुवन्त्युत्सृतीः पुनः"],"iast":["oṣadhyaḥ paśavo vṛkṣāstiryañcaḥ pakṣiṇastathā","yajñārthaṃ nidhanaṃ prāptāḥ prāpnuvantyutsṛtīḥ punaḥ"]},{"v":41,"sa":["मधुपर्के च यज्ञे च पितृदैवतकर्मणि","अत्रैव पशवो हिंस्या नान्यत्रेत्यब्रवीन्मनुः"],"iast":["madhuparke ca yajñe ca pitṛdaivatakarmaṇi","atraiva paśavo hinsyā nānyatretyabravīnmanuḥ"]},{"v":42,"sa":["एष्वर्थेषु पशून्हिंसन्वेदतत्त्वार्थविद्द्विजः","आत्मानं च पशुं चैव गमयत्युत्तमं गतिम्"],"iast":["eṣvartheṣu paśūnhinsanvedatattvārthaviddvijaḥ","ātmānaṃ ca paśuṃ caiva gamayatyuttamaṃ gatim"]},{"v":43,"sa":["गृहे गुरावरण्ये वा निवसन्नात्मवान्द्विजः","नावेदविहितां हिंसां आपद्यपि समाचरेत्"],"iast":["gṛhe gurāvaraṇye vā nivasannātmavāndvijaḥ","nāvedavihitāṃ hinsāṃ āpadyapi samācaret"]},{"v":44,"sa":["या वेदविहिता हिंसा नियतास्मिंश्चराचरे","अहिंसां एव तां विद्याद्वेदाद्धर्मो हि निर्बभौ"],"iast":["yā vedavihitā hinsā niyatāsminścarācare","ahinsāṃ eva tāṃ vidyādvedāddharmo hi nirbabhau"]},{"v":45,"sa":["योऽहिंसकानि भूतानि हिनस्त्यात्मसुखेच्छया","स जीवांश्च मृतश्चैव न क्व चित्सुखं एधते"],"iast":["yo’hinsakāni bhūtāni hinastyātmasukhecchayā","sa jīvānśca mṛtaścaiva na kva citsukhaṃ edhate"]},{"v":46,"sa":["यो बन्धनवधक्लेशान्प्राणिनां न चिकीर्षति","स सर्वस्य हितप्रेप्सुः सुखं अत्यन्तं अश्नुते"],"iast":["yo bandhanavadhakleśānprāṇināṃ na cikīrṣati","sa sarvasya hitaprepsuḥ sukhaṃ atyantaṃ aśnute"]},{"v":47,"sa":["यद्ध्यायति यत्कुरुते रतिं बध्नाति यत्र च","तदवाप्नोत्ययत्नेन यो हिनस्ति न किं चन"],"iast":["yaddhyāyati yatkurute ratiṃ badhnāti yatra ca","tadavāpnotyayatnena yo hinasti na kiṃ cana"]},{"v":48,"sa":["नाकृत्वा प्राणिनां हिंसां मांसं उत्पद्यते क्व चित्","न च प्राणिवधः स्वर्ग्यस्तस्मान्मांसं विवर्जयेत्"],"iast":["nākṛtvā prāṇināṃ hinsāṃ mānsaṃ utpadyate kva cit","na ca prāṇivadhaḥ svargyastasmānmānsaṃ vivarjayet"]},{"v":49,"sa":["समुत्पत्तिं च मांसस्य वधबन्धौ च देहिनाम्","प्रसमीक्ष्य निवर्तेत सर्वमांसस्य भक्षणात्"],"iast":["samutpattiṃ ca mānsasya vadhabandhau ca dehinām","prasamīkṣya nivarteta sarvamānsasya bhakṣaṇāt"]},{"v":50,"sa":["न भक्षयति यो मांसं विधिं हित्वा पिशाचवत्","न लोके प्रियतां याति व्याधिभिश्च न पीड्यते"],"iast":["na bhakṣayati yo mānsaṃ vidhiṃ hitvā piśācavat","na loke priyatāṃ yāti vyādhibhiśca na pīḍyate"]},{"v":51,"sa":["अनुमन्ता विशसिता निहन्ता क्रयविक्रयी","संस्कर्ता चोपहर्ता च खादकश्चेति घातकाः"],"iast":["anumantā viśasitā nihantā krayavikrayī","sanskartā copahartā ca khādakaśceti ghātakāḥ"]},{"v":52,"sa":["स्वमांसं परमांसेन यो वर्धयितुं इच्छति","अनभ्यर्च्य पितॄन्देवांस्ततोऽन्यो नास्त्यपुण्यकृत्"],"iast":["svamānsaṃ paramānsena yo vardhayituṃ icchati","anabhyarcya pitṝndevānstato’nyo nāstyapuṇyakṛt"]},{"v":53,"sa":["वर्षे वर्षेऽश्वमेधेन यो यजेत शतं समाः","मांसानि च न खादेद्यस्तयोः पुण्यफलं समम्"],"iast":["varṣe varṣe’śvamedhena yo yajeta śataṃ samāḥ","mānsāni ca na khādedyastayoḥ puṇyaphalaṃ samam"]},{"v":54,"sa":["फलमूलाशनैर्मेध्यैर्मुन्यन्नानां च भोजनैः","न तत्फलं अवाप्नोति यन्मांसपरिवर्जनात्"],"iast":["phalamūlāśanairmedhyairmunyannānāṃ ca bhojanaiḥ","na tatphalaṃ avāpnoti yanmānsaparivarjanāt"]},{"v":55,"sa":["मां स भक्षयितामुत्र यस्य मांसं इहाद्म्यहम्","एतन्मांसस्य मांसत्वं प्रवदन्ति मनीषिणः"],"iast":["māṃ sa bhakṣayitāmutra yasya mānsaṃ ihādmyaham","etanmānsasya mānsatvaṃ pravadanti manīṣiṇaḥ"]},{"v":56,"sa":["न मांसभक्षणे दोषो न मद्ये न च मैथुने","प्रवृत्तिरेषा भूतानां निवृत्तिस्तु महाफला"],"iast":["na mānsabhakṣaṇe doṣo na madye na ca maithune","pravṛttireṣā bhūtānāṃ nivṛttistu mahāphalā"]},{"v":57,"sa":["प्रेतशुद्धिं प्रवक्ष्यामि द्रव्यशुद्धिं तथैव च","चतुर्णां अपि वर्णानां यथावदनुपूर्वशः"],"iast":["pretaśuddhiṃ pravakṣyāmi dravyaśuddhiṃ tathaiva ca","caturṇāṃ api varṇānāṃ yathāvadanupūrvaśaḥ"]},{"v":58,"sa":["दन्तजातेऽनुजाते च कृतचूडे च संस्थिते","अशुद्धा बान्धवाः सर्वे सूतके च तथोच्यते"],"iast":["dantajāte
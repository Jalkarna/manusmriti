{"n":10,"verses":[{"v":1,"sa":["अधीयीरंस्त्रयो वर्णाः स्वकर्मस्था द्विजातयः","प्रब्रूयाद्ब्राह्मणस्त्वेषां नेतराविति निश्चयः"],"iast":["adhīyīranstrayo varṇāḥ svakarmasthā dvijātayaḥ","prabrūyādbrāhmaṇastveṣāṃ netarāviti niścayaḥ"]},{"v":2,"sa":["सर्वेषां ब्राह्मणो विद्याद्वृत्त्युपायान्यथाविधि","प्रब्रूयादितरेभ्यश्च स्वयं चैव तथा भवेत्"],"iast":["sarveṣāṃ brāhmaṇo vidyādvṛttyupāyānyathāvidhi","prabrūyāditarebhyaśca svayaṃ caiva tathā bhavet"]},{"v":3,"sa":["वैशेष्यात्प्रकृतिश्रैष्ठ्यान्नियमस्य च धारणात्","संस्कारस्य विशेषाच्च वर्णानां ब्राह्मणः प्रभुः"],"iast":["vaiśeṣyātprakṛtiśraiṣṭhyānniyamasya ca dhāraṇāt","sanskārasya viśeṣācca varṇānāṃ brāhmaṇaḥ prabhuḥ"]},{"v":4,"sa":["ब्राह्मणः क्षत्रियो वैश्यस्त्रयो वर्णा द्विजातयः","चतुर्थ एकजातिस्तु शूद्रो नास्ति तु पञ्चमः"],"iast":["brāhmaṇaḥ kṣatriyo vaiśyastrayo varṇā dvijātayaḥ","caturtha ekajātistu śūdro nāsti tu pañcamaḥ"]},{"v":5,"sa":["सर्ववर्णेषु तुल्यासु पत्नीष्वक्षतयोनिषु","आनुलोम्येन संभूता जात्या ज्ञेयास्त एव ते"],"iast":["sarvavarṇeṣu tulyāsu patnīṣvakṣatayoniṣu","ānulomyena sambhūtā jātyā jñeyāsta eva te"]},{"v":6,"sa":["स्त्रीष्वनन्तरजातासु द्विजैरुत्पादितान्सुतान्","सदृशानेव तानाहुर्मातृदोषविगर्हितान्"],"iast":["strīṣvanantarajātāsu dvijairutpāditānsutān","sadṛśāneva tānāhurmātṛdoṣavigarhitān"]},{"v":7,"sa":["अनन्तरासु जातानां विधिरेष सनातनः","द्व्येकान्तरासु जातानां धर्म्यं विद्यादिमं विधिम्"],"iast":["anantarāsu jātānāṃ vidhireṣa sanātanaḥ","dvyekāntarāsu jātānāṃ dharmyaṃ vidyādimaṃ vidhim"]},{"v":8,"sa":["ब्राह्मणाद्वैश्यकन्यायां अम्बष्ठो नाम जायते","निषादः शूद्रकन्यायां यः पारशव उच्यते"],"iast":["brāhmaṇādvaiśyakanyāyāṃ ambaṣṭho nāma jāyate","niṣādaḥ śūdrakanyāyāṃ yaḥ pāraśava ucyate"]},{"v":9,"sa":["क्षत्रियाच्छूद्रकन्यायां क्रूराचारविहारवान्","क्षत्रशूद्रवपुर्जन्तुरुग्रो नाम प्रजायते"],"iast":["kṣatriyācchūdrakanyāyāṃ krūrācāravihāravān","kṣatraśūdravapurjanturugro nāma prajāyate"]},{"v":10,"sa":["विप्रस्य त्रिषु वर्णेषु नृपतेर्वर्णयोर्द्वयोः","वैश्यस्य वर्णे चैकस्मिन्षडेतेऽपसदाः स्मृताः"],"iast":["viprasya triṣu varṇeṣu nṛpatervarṇayordvayoḥ","vaiśyasya varṇe caikasminṣaḍete’pasadāḥ smṛtāḥ"]},{"v":11,"sa":["क्षत्रियाद्विप्रकन्यायां सूतो भवति जातितः","वैश्यान्मागधवैदेहौ राजविप्राङ्गनासुतौ"],"iast":["kṣatriyādviprakanyāyāṃ sūto bhavati jātitaḥ","vaiśyānmāgadhavaidehau rājaviprāṅganāsutau"]},{"v":12,"sa":["शूद्रादायोगवः क्षत्ता चण्डालश्चाधमो नृणाम्","वैश्यराजन्यविप्रासु जायन्ते वर्णसंकराः"],"iast":["śūdrādāyogavaḥ kṣattā caṇḍālaścādhamo nṛṇām","vaiśyarājanyaviprāsu jāyante varṇasaṅkarāḥ"]},{"v":13,"sa":["एकान्तरे त्वानुलोम्यादम्बष्ठोग्रौ यथा स्मृतौ","क्षत्तृवैदेहकौ तद्वत्प्रातिलोम्येऽपि जन्मनि"],"iast":["ekāntare tvānulomyādambaṣṭhograu yathā smṛtau","kṣattṛvaidehakau tadvatprātilomye’pi janmani"]},{"v":14,"sa":["पुत्रा येऽनन्तरस्त्रीजाः क्रमेणोक्ता द्विजन्मनाम्","ताननन्तरनाम्नस्तु मातृदोषात्प्रचक्षते"],"iast":["putrā ye’nantarastrījāḥ krameṇoktā dvijanmanām","tānanantaranāmnastu mātṛdoṣātpracakṣate"]},{"v":15,"sa":["ब्राह्मणादुग्रकन्यायां आवृतो नाम जायते","आभीरोऽम्बष्ठकन्यायां आयोगव्यां तु धिग्वणः"],"iast":["brāhmaṇādugrakanyāyāṃ āvṛto nāma jāyate","ābhīro’mbaṣṭhakanyāyāṃ āyogavyāṃ tu dhigvaṇaḥ"]},{"v":16,"sa":["आयोगवश्च क्षत्ता च चण्डालश्चाधमो नृणाम्","प्रातिलोम्येन जायन्ते शूद्रादपसदास्त्रयः"],"iast":["āyogavaśca kṣattā ca caṇḍālaścādhamo nṛṇām","prātilomyena jāyante śūdrādapasadāstrayaḥ"]},{"v":17,"sa":["वैश्यान्मागधवैदेहौ क्षत्रियात्सूत एव तु","प्रतीपं एते जायन्ते परेऽप्यपसदास्त्रयः"],"iast":["vaiśyānmāgadhavaidehau kṣatriyātsūta eva tu","pratīpaṃ ete jāyante pare’pyapasadāstrayaḥ"]},{"v":18,"sa":["जातो निषादाच्छूद्रायां जात्या भवति पुक्कसः","शूद्राज्जातो निषाद्यां तु स वै कुक्कुटकः स्मृतः"],"iast":["jāto niṣādācchūdrāyāṃ jātyā bhavati pukkasaḥ","śūdrājjāto niṣādyāṃ tu sa vai kukkuṭakaḥ smṛtaḥ"]},{"v":19,"sa":["क्षत्तुर्जातस्तथोग्रायां श्वपाक इति कीर्त्यते","वैदेहकेन त्वम्बष्ठ्यां उत्पन्नो वेण उच्यते"],"iast":["kṣatturjātastathogrāyāṃ śvapāka iti kīrtyate","vaidehakena tvambaṣṭhyāṃ utpanno veṇa ucyate"]},{"v":20,"sa":["द्विजातयः सवर्णासु जनयन्त्यव्रतांस्तु यान्","तान्सावित्रीपरिभ्रष्टान्व्रात्यानिति विनिर्दिशेत्"],"iast":["dvijātayaḥ savarṇāsu janayantyavratānstu yān","tānsāvitrīparibhraṣṭānvrātyāniti vinirdiśet"]},{"v":21,"sa":["व्रात्यात्तु जायते विप्रात्पापात्मा भूर्जकण्टकः","आवन्त्यवाटधानौ च पुष्पधः शैख एव च"],"iast":["vrātyāttu jāyate viprātpāpātmā bhūrjakaṇṭakaḥ","āvantyavāṭadhānau ca puṣpadhaḥ śaikha eva ca"]},{"v":22,"sa":["झल्लो मल्लश्च राजन्याद्व्रात्यान्निच्छिविरेव च","नटश्च करणश्चैव खसो द्रविड एव च"],"iast":["jhallo mallaśca rājanyādvrātyānnicchivireva ca","naṭaśca karaṇaścaiva khaso draviḍa eva ca"]},{"v":23,"sa":["वैश्यात्तु जायते व्रात्यात्सुधन्वाचार्य एव च","कारुषश्च विजन्मा च मैत्रः सात्वत एव च"],"iast":["vaiśyāttu jāyate vrātyātsudhanvācārya eva ca","kāruṣaśca vijanmā ca maitraḥ sātvata eva ca"]},{"v":24,"sa":["व्यभिचारेण वर्णानां अवेद्यावेदनेन च","स्वकर्मणां च त्यागेन जायन्ते वर्णसंकराः"],"iast":["vyabhicāreṇa varṇānāṃ avedyāvedanena ca","svakarmaṇāṃ ca tyāgena jāyante varṇasaṅkarāḥ"]},{"v":25,"sa":["संकीर्णयोनयो ये तु प्रतिलोमानुलोमजाः","अन्योन्यव्यतिषक्ताश्च तान्प्रवक्ष्याम्यशेषतः"],"iast":["saṅkīrṇayonayo ye tu pratilomānulomajāḥ","anyonyavyatiṣaktāśca tānpravakṣyāmyaśeṣataḥ"]},{"v":26,"sa":["सूतो वैदेहकश्चैव चण्डालश्च नराधमः","मागधः तथायोगव एव च क्षत्रजातिश्च"],"iast":["sūto vaidehakaścaiva caṇḍālaśca narādhamaḥ","māgadhaḥ tathāyogava eva ca kṣatrajātiśca"]},{"v":27,"sa":["एते षट्सदृशान्वर्णाञ् जनयन्ति स्वयोनिषु","मातृजात्यां प्रसूयन्ते प्रवारासु च योनिषु"],"iast":["ete ṣaṭsadṛśānvarṇāñ janayanti svayoniṣu","mātṛjātyāṃ prasūyante pravārāsu ca yoniṣu"]},{"v":28,"sa":["यथा त्रयाणां वर्णानां द्वयोरात्मास्य जायते","आनन्तर्यात्स्वयोन्यां तु तथा बाह्येष्वपि क्रमात्"],"iast":["yathā trayāṇāṃ varṇānāṃ dvayorātmāsya jāyate","ānantaryātsvayonyāṃ tu tathā bāhyeṣvapi kramāt"]},{"v":29,"sa":["ते चापि बाह्यान्सुबहूंस्ततोऽप्यधिकदूषितान्","परस्परस्य दारेषु जनयन्ति विगर्हितान्"],"iast":["te cāpi bāhyānsubahūnstato’pyadhikadūṣitān","parasparasya dāreṣu janayanti vigarhitān"]},{"v":30,"sa":["यथैव शूद्रो ब्राह्मण्यां बाह्यं जन्तुं प्रसूयते","तथा बाह्यतरं बाह्यश्चातुर्वर्ण्ये प्रसूयते"],"iast":["yathaiva śūdro brāhmaṇyāṃ bāhyaṃ jantuṃ prasūyate","tathā bāhyataraṃ bāhyaścāturvarṇye prasūyate"]},{"v":31,"sa":["प्रतिकूलं वर्तमाना बाह्या बाह्यतरान्पुनः","हीना हीनान्प्रसूयन्ते वर्णान्पञ्चदशैव तु"],"iast":["pratikūlaṃ vartamānā bāhyā bāhyatarānpunaḥ","hīnā hīnānprasūyante varṇānpañcadaśaiva tu"]},{"v":32,"sa":["प्रसाधनोपचारज्ञं अदासं दासजीवनम्","सैरिन्ध्रं वागुरावृत्तिं सूते दस्युरयोगवे"],"iast":["prasādhanopacārajñaṃ adāsaṃ dāsajīvanam","sairindhraṃ vāgurāvṛttiṃ sūte dasyurayogave"]},{"v":33,"sa":["मैत्रेयकं तु वैदेहो माधूकं संप्रसूयते","नॄन्प्रशंसत्यजस्रं यो घण्टाताडोऽरुणोदये"],"iast":["maitreyakaṃ tu vaideho mādhūkaṃ samprasūyate","nṝnpraśansatyajasraṃ yo ghaṇṭātāḍo’ruṇodaye"]},{"v":34,"sa":["निषादो मार्गवं सूते दासं नौकर्मजीविनम्","कैवर्तं इति यं प्राहुरार्यावर्तनिवासिनः"],"iast":["niṣādo mārgavaṃ sūte dāsaṃ naukarmajīvinam","kaivartaṃ iti yaṃ prāhurāryāvartanivāsinaḥ"]},{"v":35,"sa":["मृतवस्त्रभृत्स्व्नारीषु गर्हितान्नाशनासु च","भवन्त्यायोगवीष्वेते जातिहीनाः पृथक्त्रयः"],"iast":["mṛtavastrabhṛtsvnārīṣu garhitānnāśanāsu ca","bhavantyāyogavīṣvete jātihīnāḥ pṛthaktrayaḥ"]},{"v":36,"sa":["कारावरो निषादात्तु चर्मकारः प्रसूयते","वैदेहिकादन्ध्रमेदौ बहिर्ग्रामप्रतिश्रयौ"],"iast":["kārāvaro niṣādāttu carmakāraḥ prasūyate","vaidehikādandhramedau bahirgrāmapratiśrayau"]},{"v":37,"sa":["चण्डालात्पाण्डुसोपाकस्त्वक्सारव्यवहारवान्","आहिण्डिको निषादेन वैदेह्यां एव जायते"],"iast":["caṇḍālātpāṇḍusopākastvaksāravyavahāravān","āhiṇḍiko niṣādena vaidehyāṃ eva jāyate"]},{"v":38,"sa":["चण्डालेन तु सोपाको मूलव्यसनवृत्तिमान्","पुक्कस्यां जायते पापः सदा सज्जनगर्हितः"],"iast":["caṇḍālena tu sopāko mūlavyasanavṛttimān","pukkasyāṃ jāyate pāpaḥ sadā sajjanagarhitaḥ"]},{"v":39,"sa":["निषादस्त्री तु चण्डालात्पुत्रं अन्त्यावसायिनम्","श्मशानगोचरं सूते बाह्यानां अपि गर्हितम्"],"iast":["niṣādastrī tu caṇḍālātputraṃ antyāvasāyinam","śmaśānagocaraṃ sūte bāhyānāṃ api garhitam"]},{"v":40,"sa":["संकरे जातयस्त्वेताः पितृमातृप्रदर्शिताः","प्रछन्ना वा प्रकाशा वा वेदितव्याः स्वकर्मभिः"],"iast":["saṅkare jātayastvetāḥ pitṛmātṛpradarśitāḥ","prachannā vā prakāśā vā veditavyāḥ svakarmabhiḥ"]},{"v":41,"sa":["स्वजातिजानन्तरजाः षट्सुता द्विजधर्मिणः","शूद्राणां तु सधर्माणः सर्वेऽपध्वंसजाः स्मृताः"],"iast":["svajātijānantarajāḥ ṣaṭsutā dvijadharmiṇaḥ","śūdrāṇāṃ tu sadharmāṇaḥ sarve’padhvansajāḥ smṛtāḥ"]},{"v":42,"sa":["तपोबीजप्रभावैस्तु ते गच्छन्ति युगे युगे","उत्कर्षं चापकर्षं च मनुष्येष्विह जन्मतः"],"iast":["tapobījaprabhāvaistu te gacchanti yuge yuge","utkarṣaṃ cāpakarṣaṃ ca manuṣyeṣviha janmataḥ"]},{"v":43,"sa":["शनकैस्तु क्रियालोपादिमाः क्षत्रियजातयः","वृषलत्वं गता लोके ब्राह्मणादर्शनेन च"],"iast":["śanakaistu kriyālopādimāḥ kṣatriyajātayaḥ","vṛṣalatvaṃ gatā loke brāhmaṇādarśanena ca"]},{"v":44,"sa":["पौण्ड्रकाश्चौड्रद्रविडाः काम्बोजा यवनाः शकाः","पारदापह्लवाश्चीनाः किराता दरदाः खशाः"],"iast":["pauṇḍrakāścauḍradraviḍāḥ kāmbojā yavanāḥ śakāḥ","pāradāpahlavāścīnāḥ kirātā daradāḥ khaśāḥ"]},{"v":45,"sa":["मुखबाहूरुपज्जानां या लोके जातयो बहिः","म्लेच्छवाचश्चार्यवाचः सर्वे ते दस्यवः स्मृताः"],"iast":["mukhabāhūrupajjānāṃ yā loke jātayo bahiḥ","mlecchavācaścāryavācaḥ sarve te dasyavaḥ smṛtāḥ"]},{"v":46,"sa":["ये द्विजानां अपसदा ये चापध्वंसजाः स्मृताः","ते निन्दितैर्वर्तयेयुर्द्विजानां एव कर्मभिः"],"iast":["ye dvijānāṃ apasadā ye cāpadhvansajāḥ smṛtāḥ","te ninditairvartayeyurdvijānāṃ eva karmabhiḥ"]},{"v":47,"sa":["सूतानां अश्वसारथ्यं अम्बष्ठानां चिकित्सनम्","वैदेहकानां स्त्रीकार्यं मागधानां वणिक्पथः"],"iast":["sūtānāṃ aśvasārathyaṃ ambaṣṭhānāṃ cikitsanam","vaidehakānāṃ strīkāryaṃ māgadhānāṃ vaṇikpathaḥ"]},{"v":48,"sa":["मत्स्यघातो निषादानां त्वष्टिस्त्वायोगवस्य च","मेदान्ध्रचुञ्चुमद्गूनां आरण्यपशुहिंसनम्"],"iast":["matsyaghāto niṣādānāṃ tvaṣṭistvāyogavasya ca","medāndhracuñcumadgūnāṃ āraṇyapaśuhinsanam"]},{"v":49,"sa":["क्षत्त्रुग्रपुक्कसानां तु बिलौकोवधबन्धनम्","धिग्वणानां चर्मकार्यं वेणानां भाण्डवादनम्"],"iast":["kṣattrugrapukkasānāṃ tu bilaukovadhabandhanam","dhigvaṇānāṃ carmakāryaṃ veṇānā
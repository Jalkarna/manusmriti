[
 {
  "verse": 1,
  "line": 0,
  "text": "चातुर्वर्ण्यस्य कृत्स्नोऽयं उक्तो धर्मस्त्वयानघः",
  "start": 0.0,
  "end": 5.07
 },
 {
  "verse": 1,
  "line": 1,
  "text": "कर्मणां फलनिर्वृत्तिं शंस नस्तत्त्वतः पराम्",
  "start": 5.42,
  "end": 10.11
 },
 {
  "verse": 2,
  "line": 0,
  "text": "स तानुवाच धर्मात्मा महर्षीन्मानवो भृगुः",
  "start": 10.86,
  "end": 15.65
 },
 {
  "verse": 2,
  "line": 1,
  "text": "अस्य सर्वस्य शृणुत कर्मयोगस्य निर्णयम्",
  "start": 16.0,
  "end": 20.17
 },
 {
  "verse": 3,
  "line": 0,
  "text": "शुभाशुभफलं कर्म मनोवाग्देहसंभवम्",
  "start": 20.92,
  "end": 25.37
 },
 {
  "verse": 3,
  "line": 1,
  "text": "कर्मजा गतयो नॄणां उत्तमाधममध्यमः",
  "start": 25.72,
  "end": 30.47
 },
 {
  "verse": 4,
  "line": 0,
  "text": "तस्येह त्रिविधस्यापि त्र्यधिष्ठानस्य देहिनः",
  "start": 31.22,
  "end": 35.97
 },
 {
  "verse": 4,
  "line": 1,
  "text": "दशलक्षणयुक्तस्य मनो विद्यात्प्रवर्तकम्",
  "start": 36.32,
  "end": 40.63
 },
 {
  "verse": 5,
  "line": 0,
  "text": "परद्रव्येष्वभिध्यानं मनसानिष्टचिन्तनम्",
  "start": 41.38,
  "end": 45.93
 },
 {
  "verse": 5,
  "line": 1,
  "text": "वितथाभिनिवेशश्च त्रिविधं कर्म मानसम्",
  "start": 46.28,
  "end": 50.67
 },
 {
  "verse": 6,
  "line": 0,
  "text": "पारुष्यं अनृतं चैव पैशुन्यं चापि सर्वशः",
  "start": 51.42,
  "end": 56.05
 },
 {
  "verse": 6,
  "line": 1,
  "text": "असंबद्धप्रलापश्च वाङ्मयं स्याच्चतुर्विधम्",
  "start": 56.4,
  "end": 61.09
 }
]